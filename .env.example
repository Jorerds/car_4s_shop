# ===== 应用配置 =====
# JWT 密钥：生产环境必须替换为强随机值
JWT_SECRET=change-me-in-production
DEBUG=false

# ===== 短信服务商 =====
# mock=开发模拟（验证码打印到日志） / aliyun / tencent（上线前接入）
SMS_PROVIDER=mock

# ===== 数据库（docker-compose 会覆盖为容器内地址，本地开发用下面的值）=====
# 注意：本机已装有 MySQL(3306)/Redis(6379)，项目容器映射到 3307/6380 避免冲突
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3307/ai_4s?charset=utf8mb4

# ===== MySQL root 密码（docker-compose 使用）=====
MYSQL_ROOT_PASSWORD=root

# ===== Redis =====
# 本机 Redis 占用 6379，6380-6479 为 Windows 保留端口段，项目容器用 16379
REDIS_URL=redis://127.0.0.1:16379/0
